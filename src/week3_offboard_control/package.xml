<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>week3_offboard_control</name>
  <version>0.0.1</version>
  <description>Week 3 onboarding exercise: minimal PX4 offboard control (arm, takeoff, waypoints, land)</description>
  <maintainer email="theamitsail@gmail.com">Amit Sail</maintainer>
  <license>BSD-3</license>

  <depend>px4_msgs</depend>
  <depend>rclpy</depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>week2_px4_sitl</exec_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
